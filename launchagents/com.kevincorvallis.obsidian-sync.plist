<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: bootstrap.sh (launchagents flag) replaces __HOME__ with $HOME (launchd does not expand ~).
     Load it on exactly one machine: iCloud syncs the vault's .git, so two committers race. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kevincorvallis.obsidian-sync</string>

	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/bin/obsidian-sync</string>
	</array>

	<!-- Daily 18:00. If the Mac was asleep, launchd runs it once on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>18</integer>
		<key>Minute</key><integer>0</integer>
	</dict>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/bin:__HOME__/.local/bin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/obsidian-sync.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/obsidian-sync.log</string>
</dict>
</plist>
