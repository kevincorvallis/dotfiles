#!/usr/bin/env zsh
# ~/.aliases - sourced by ~/.zshrc

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~" # `cd` is probably faster to type though
alias -- -="cd -"

# Command-replacing aliases (cd->z, ls->eza, cat->bat) only in a human terminal.
# Scripts and agent shells (Claude Code sets CLAUDECODE) keep the real commands,
# so POSIX flags like `ls -lt` work there and agent `cd`s stay out of zoxide.
if [[ -o interactive && -t 1 && -z "${CLAUDECODE:-}" ]]; then
	command -v zoxide &> /dev/null && alias cd="z"
	if command -v eza &> /dev/null; then
		alias ls="eza"
	else
		alias ls="command ls -G"
	fi
	command -v bat &> /dev/null && alias cat="bat --paging=never"
fi

# Listings: l long, la/ll long with dotfiles, lt tree, lsd directories only
if command -v eza &> /dev/null; then
	alias l="eza -l"
	alias la="eza -la"
	alias ll="eza -la"
	alias lt="eza -la --tree --level=2"
	alias lsd="eza -lD"
else
	alias l="command ls -lFG"
	alias la="command ls -lAFG"
	alias ll="command ls -lAFG"
	alias lsd="command ls -lFG | grep --color=never '^d'"
fi

# Variants of the modern tools: cat with paging, find/grep including ignored files, interactive z
command -v bat &> /dev/null && alias catp="bat"
command -v fd &> /dev/null && alias fdi="fd --no-ignore"
command -v rg &> /dev/null && alias rgi="rg --no-ignore"
command -v zoxide &> /dev/null && alias cdi="zi"

alias g="git"

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Keep Mac awake for 10 hours in the background (long Claude Code runs); kill early with the printed pid
alias awwke='nohup caffeinate -is -t 36000 >/dev/null 2>&1 & echo "☕ staying awake for 10h (pid $!)"'

# Open the dotfiles repo (not the deployed copies in ~); run bootstrap.sh to deploy edits
alias edit='if [[ ! -d "${DOTFILES:-}" ]]; then echo "edit: set DOTFILES to the repo path (see ~/.extra)" >&2; false; elif command -v subl >/dev/null 2>&1; then subl "$DOTFILES"; else "${EDITOR:-vi}" "$DOTFILES"; fi'

# Directory shortcuts
alias dw="cd \"$HOME/Downloads\""
alias dt="cd \"$HOME/Desktop\""
alias ic="cd \"$HOME/Library/Mobile Documents/com~apple~CloudDocs\"" # iCloud Drive
alias obsidian="cd ~/Library/Mobile\ Documents/iCloud~md~obsidian"

# Shell
alias reload='exec "$SHELL" -l'
alias path='print -l $path'   # one PATH entry per line
alias c="tr -d '\n' | pbcopy" # copy stdin without newlines
alias afk="pmset displaysleepnow"

# Network: public IP, LAN IP (Ethernet, then Wi-Fi), flush DNS
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ipconfig getifaddr en0 || ipconfig getifaddr en1"
alias flush="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

# Finder: show/hide hidden files; delete .DS_Store files below here
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"

# Sublime Text shortcut
alias s="subl"

# Charging: wall draw vs. system load, net battery flow, and ETA to 80% (laptops only)
watts() {
	ioreg -rn AppleSmartBattery 2>/dev/null | grep -q BatteryPower || { echo "watts: no battery on this Mac" >&2; return 1; }
	ioreg -rn AppleSmartBattery | perl -e '
	local $/; my $d = <STDIN>;
	# ioreg prints top-level props as "k" = v and nested dict entries as "k"=v.
	# The spacing is the ONLY thing separating them: UpdateTime and Voltage each
	# appear twice (top level, and nested in LifetimeData/BatteryData), so a
	# tolerant \s* here silently picks whichever ioreg happened to print first.
	# Negative values arrive as unsigned 64-bit, hence the pack/unpack round-trip.
	sub num { my ($k, $top, $h) = @_; $h = $d unless defined $h;
		my $re = $top ? qr/"\Q$k\E" = (\d+)/ : qr/"\Q$k\E"=(\d+)/;
		my ($v) = $h =~ $re; return defined $v ? unpack("q", pack("Q", $v+0)) : undef; }
	sub hm { my $m = shift; $m < 60 ? sprintf("%dm", $m) : sprintf("%dh %02dm", $m/60, $m%60); }

	my $net = num("BatteryPower")/1000;    # W into (+) or out of (-) the battery
	my $vb  = num("Voltage", 1)/1000;      # battery volts
	my $age = time - (num("UpdateTime", 1) // time);
	# macOS reports % against nominal capacity, which counts a reserve the raw
	# gauge figure excludes. Work in nominal units so % and mAh agree.
	my $res  = num("PackReserve", 1) // 0;
	my $nom  = num("NominalChargeCapacity", 1) // (num("AppleRawMaxCapacity", 1) + $res);
	my $have = num("AppleRawCurrentCapacity", 1) + $res;
	my $want = int($nom * 0.80);

	# Scope adapter fields to the AdapterDetails dict. AppleRawAdapterDetails is
	# printed first and keeps a stale Watts after unplug, so an unscoped match
	# reports a phantom charger. (It is an array, so " = {" excludes it.)
	my ($ad) = $d =~ /"AdapterDetails" = \{(.*?)\}/;
	$ad = "" unless defined $ad;
	# Both checks: during a plug/unplug transition ExternalConnected still reads
	# Yes for a beat after AdapterDetails has collapsed to {"FamilyCode"=0}.
	my $w = num("Watts", 0, $ad);
	unless ($d =~ /"ExternalConnected" = Yes/ && $w) {
		printf "🔋 %.0f%%  (%d/%d mAh)  ·  on battery\n", $have/$nom*100, $have, $nom;
		printf "   draw %.1f W\n", abs($net);
		my $e = num("AvgTimeToEmpty", 1);
		printf "   empty in %s\n", hm($e) if $e && $e != 65535;
		exit;
	}

	printf "⚡ %dW charger  (%.1fV / %.2fA negotiated)\n",
		$w, num("AdapterVoltage", 0, $ad)/1000, num("Current", 0, $ad)/1000;
	printf "   from wall  %5.1f W\n", num("SystemPowerIn")/1000;
	printf "   system     %5.1f W\n", num("SystemLoad")/1000;
	printf "   battery   %+5.1f W  %s\n\n", $net,
		  $net >  0.15 ? "\x1b[32m▲ charging\x1b[0m"
		: $net < -0.15 ? "\x1b[31m▼ draining (load exceeds adapter)\x1b[0m"
		:                "\x1b[33m● holding steady\x1b[0m";

	printf "🔋 %.0f%%  (%d/%d mAh)  ·  80%% = %d mAh\n", $have/$nom*100, $have, $nom, $want;
	if ($have >= $want) {
		print "   already at/above 80%\n";
	} elsif ($net > 0.15) {
		# Derive mA from net power, not the gas gauge: the two disagree at low
		# rates and the gauge will happily claim +13 mA while the pack drains.
		# Linear estimate holds through constant-current, optimistic past ~80%.
		my $ma = $net / $vb * 1000;
		my $mins = ($want - $have) / $ma * 60;
		printf $mins > 1440 ? "   to 80%%: %s at %.0f mA — barely trickling\n"
		                    : "   to 80%%: ~%s  (%.0f mA)\n", hm($mins), $ma;
	} else {
		print "   to 80%: \x1b[31mnever at this rate\x1b[0m — lighten the load or get a bigger charger\n";
	}
	printf "   \x1b[2mreading %ds old\x1b[0m\n", $age;
	'
}

# Live view. The gauge only updates every 60s, so poll cheaply and reprint on change.
wattsw() {
	ioreg -rn AppleSmartBattery 2>/dev/null | grep -q BatteryPower || { echo "wattsw: no battery on this Mac" >&2; return 1; }
	local last=""
	while :; do
		local stamp=$(ioreg -rn AppleSmartBattery | grep -oE '"UpdateTime" = [0-9]+')
		[[ "$stamp" != "$last" ]] && { last="$stamp"; watts; echo; }
		sleep 5
	done
}

# YouTube downloader: prefer H.264 (plays everywhere), fall back to any codec, merge to mp4 (needs ffmpeg)
yt() { yt-dlp --no-playlist -f "bv*[vcodec^=avc1][ext=mp4]+ba[ext=m4a]/bv*[ext=mp4]+ba[ext=m4a]/bv*+ba/b" --merge-output-format mp4 "$@"; }
ytmp3() { yt-dlp -x --audio-format mp3 --no-playlist "$@"; }
