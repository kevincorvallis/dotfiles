  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "verbose": true,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pre-bash-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-secret-stage.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "sandbox": {
    "enabled": true
  }
}
