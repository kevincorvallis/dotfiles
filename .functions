#!/usr/bin/env zsh
# ~/.functions - sourced by ~/.zshrc

# Update macOS, Homebrew, Claude Code, npm, pip, and pull every git repo under ~/code/<group>/<repo>
function update() {
	setopt local_options no_monitor no_notify

	local bg='\033[1;32m' dg='\033[2;32m'
	local br='\033[1;31m'
	local y='\033[33m' c='\033[36m' bc='\033[1;36m'
	local b='\033[1m' d='\033[2m' n='\033[0m'
	local clr='\033[2K' hide='\033[?25l' show='\033[?25h'
	local spinner='⣾⣽⣻⢿⡿⣟⣯⣷'

	# Shared with the nested helpers below (zsh locals are dynamically scoped),
	# so the helpers must be called directly, never inside $(...).
	local -a results=() failures=() details=() repo_counts=()
	local step_count=0 repos_synced=0
	local start_time=$SECONDS
	local _tmpout
	_tmpout=$(mktemp) || return 1
	local sudo_keepalive_pid=""

	trap "printf '${show}'; rm -f '${_tmpout}'; [[ -n \$sudo_keepalive_pid ]] && kill \$sudo_keepalive_pid 2>/dev/null; trap - INT TERM EXIT; return 130" INT TERM
	trap "printf '${show}'; rm -f '${_tmpout}'; [[ -n \$sudo_keepalive_pid ]] && kill \$sudo_keepalive_pid 2>/dev/null" EXIT

	_spin() {
		local pid=$1 name=$2 i=0
		printf "${hide}"
		while kill -0 "$pid" 2>/dev/null; do
			local frame="${spinner:$((i % ${#spinner})):1}"
			local elapsed=$(( SECONDS - step_start ))
			printf "${clr}\r  ${bg}${frame}${n} ${b}%-22s${n} ${d}%ds${n}" "$name" "$elapsed"
			((i++))
			sleep 0.08
		done
		printf "${show}"
	}

	_step() {
		local name="$1" parse="$2"; shift 2
		local step_start=$SECONDS

		eval "$@" > "$_tmpout" 2>&1 &
		local cmd_pid=$!
		_spin $cmd_pid "$name"
		wait $cmd_pid 2>/dev/null
		local rc=$?

		((step_count++))
		local elapsed_step=$(( SECONDS - step_start ))
		local detail=""
		if [[ -n "$parse" ]] && (( rc == 0 )); then
			detail=$(eval "$parse" < "$_tmpout" 2>/dev/null)
			# treat empty, whitespace-only, or "0 ..." as no detail
			[[ "$detail" =~ ^[[:space:]]*$ ]] && detail=""
			[[ "$detail" =~ ^0[[:space:]] ]] && detail=""
		fi

		if (( rc == 0 )); then
			if [[ -n "$detail" ]]; then
				printf "${clr}\r  ${bg}✓${n} %-22s ${c}%s${n} ${d}%ds${n}\n" "$name" "$detail" "$elapsed_step"
				details+=("${name}: ${detail}")
			else
				printf "${clr}\r  ${bg}✓${n} %-22s ${d}%ds${n}\n" "$name" "$elapsed_step"
			fi
			results+=("$name")
		else
			printf "${clr}\r  ${br}✗${n} %-22s ${y}skipped${n} ${d}%ds${n}\n" "$name" "$elapsed_step"
			failures+=("$name")
		fi
	}

	# Pull each repo under ~/code/<group>/<repo>, one section per group
	_sync_repos() {
		local group dir repo branch before ahead err rc pid step_start elapsed_step group_synced
		for group in "$HOME"/code/*(N/); do
			group_synced=-1    # -1 until the group's first repo prints its header
			for dir in "$group"/*(N/); do
				[[ -d "$dir/.git" ]] || continue
				if (( group_synced < 0 )); then
					printf "\n  ${bg}┌ Git — %s${n}\n" "${group:t}"
					group_synced=0
				fi
				repo="${dir:t}"
				# Local-only repos and detached HEADs have nothing to pull
				if ! git -C "$dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
					printf "  ${d}–${n} %-18s ${d}no upstream${n}\n" "$repo"
					continue
				fi
				step_start=$SECONDS
				before=$(git -C "$dir" rev-parse HEAD 2>/dev/null)
				# --ff-only never rebases or merges: a repo that can't fast-forward fails untouched
				git -C "$dir" fetch --all > "$_tmpout" 2>&1 && git -C "$dir" pull --ff-only >> "$_tmpout" 2>&1 &
				pid=$!
				_spin $pid "$repo"
				wait $pid 2>/dev/null
				rc=$?
				elapsed_step=$(( SECONDS - step_start ))
				if (( rc == 0 )); then
					branch=$(git -C "$dir" branch --show-current 2>/dev/null)
					ahead=$(git -C "$dir" rev-list --count "${before}..HEAD" 2>/dev/null || echo 0)
					if (( ahead > 0 )); then
						printf "${clr}\r  ${bg}✓${n} %-18s ${c}%s ${bc}+%d new${n} ${d}%ds${n}\n" \
							"$repo" "$branch" "$ahead" "$elapsed_step"
						details+=("${repo}: +${ahead} commits on ${branch}")
					else
						printf "${clr}\r  ${bg}✓${n} %-18s ${d}%s %ds${n}\n" \
							"$repo" "$branch" "$elapsed_step"
					fi
					(( group_synced += 1, repos_synced += 1 ))
				else
					if grep -q 'Not possible to fast-forward' "$_tmpout"; then
						err="diverged, pull manually"
					else
						err=$(grep -oE 'error:|fatal:' "$_tmpout" | head -1)
					fi
					printf "${clr}\r  ${br}✗${n} %-18s ${y}%s${n} ${d}%ds${n}\n" \
						"$repo" "${err:-failed}" "$elapsed_step"
					failures+=("git: ${group:t}/${repo}")
				fi
			done
			if (( group_synced > 0 )); then
				repo_counts+=("${group_synced} ${group:t}")
			fi
		done
	}

	# --- header ---
	clear
	echo ""
	local datestamp=$(date '+%a %b %-d, %H:%M')
	printf "  ${bg}╔════════════════════════════════════════╗${n}\n"
	printf "  ${bg}║${n}  ${bg}⟳  System Update${n}  ${d}%-20s${n} ${bg}║${n}\n" "$datestamp"
	printf "  ${bg}╚════════════════════════════════════════╝${n}\n"

	# --- pre-authenticate sudo ---
	printf "\n  ${d}Enter password for sudo:${n}\n"
	if sudo -v 2>/dev/null; then
		printf "  ${bg}✓${n} ${d}authenticated${n}\n"
		while true; do sudo -n true 2>/dev/null; sleep 50; done &
		sudo_keepalive_pid=$!
	else
		printf "  ${y}▸${n} ${d}sudo skipped${n}\n"
	fi

	# --- system ---
	printf "\n  ${bg}┌ System${n}\n"
	_step "macOS Software Update" \
		"grep -ci 'installed' | xargs -I{} echo '{} updates'" \
		"sudo -n softwareupdate -i -a"

	# --- packages (each step skipped when its tool isn't installed) ---
	printf "\n  ${bg}┌ Packages${n}\n"
	if command -v brew &>/dev/null; then
		_step "Homebrew" \
			"grep -c 'Updated' 2>/dev/null | xargs -I{} echo '{} taps refreshed'" \
			"brew update"
		_step "Brew upgrade" \
			"grep '^==> Upgrading' | sed 's/==> Upgrading //' | paste -sd', ' - | cut -c1-40" \
			"brew upgrade"
		_step "Brew cleanup" \
			"grep -oE 'Removing.*' | wc -l | tr -d ' ' | xargs -I{} echo '{} stale files'" \
			"brew cleanup"
		_step "Brew doctor" "" "brew doctor || true"
	fi
	command -v claude &>/dev/null && _step "Claude Code" \
		"grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1 | xargs -I{} echo 'v{}'" \
		"claude update"
	command -v npm &>/dev/null && _step "npm" \
		"grep -E 'added|updated|changed' | tail -1 | sed 's/^[ ]*//' | cut -c1-40" \
		"npm install npm -g && npm update -g"
	command -v python3 &>/dev/null && _step "pip" \
		"grep -oE 'pip-[0-9.]+' | tail -1 | sed 's/pip-/v/'" \
		"python3 -m pip install --upgrade pip --break-system-packages"
	command -v gcloud &>/dev/null && _step "gcloud" \
		"grep -ci 'updated' | xargs -I{} echo '{} components'" \
		"gcloud components update --quiet"

	# --- maintenance ---
	if command -v docker &>/dev/null; then
		printf "\n  ${bg}┌ Maintenance${n}\n"
		_step "Docker prune" \
			"grep -oE 'reclaimed [0-9.]+ [A-Za-z]+' | head -1" \
			"docker system prune -f"
	fi

	# --- progress bar (once, after all steps): share of steps that succeeded ---
	local pct=0
	(( step_count > 0 )) && pct=$(( ${#results[@]} * 100 / step_count ))
	local filled=$(( pct * 25 / 100 ))
	local empty=$(( 25 - filled ))
	local bar_f="" bar_e=""
	(( filled > 0 )) && bar_f=$(printf '%.0s━' {1..$filled})
	(( empty > 0 ))  && bar_e=$(printf '%.0s─' {1..$empty})
	printf "\n  ${dg}[${bg}%s${dg}%s${dg}]${n} ${b}%d%%${n} ${d}%d/%d steps ok${n}\n" \
		"$bar_f" "$bar_e" "$pct" "${#results[@]}" "$step_count"

	# --- git repos ---
	_sync_repos

	# --- summary ---
	local elapsed=$(( SECONDS - start_time ))
	local mins=$(( elapsed / 60 ))
	local secs=$(( elapsed % 60 ))

	echo ""
	printf "  ${bg}━━━ Results ━━━━━━━━━━━━━━━━━━━━━━━━━━━━${n}\n"
	echo ""
	printf "  ${bg}✓${n} ${b}%d${n} packages updated\n" "${#results[@]}"
	if (( ${#repo_counts[@]} > 0 )); then
		printf "  ${bg}✓${n} ${b}%d${n} repos synced ${d}(%s)${n}\n" "$repos_synced" "${(j:, :)repo_counts}"
	else
		printf "  ${bg}✓${n} ${b}%d${n} repos synced\n" "$repos_synced"
	fi
	if (( ${#failures[@]} > 0 )); then
		printf "  ${br}✗${n} ${b}%d${n} failed\n" "${#failures[@]}"
		for f in "${failures[@]}"; do
			printf "    ${y}▸ %s${n}\n" "$f"
		done
	else
		printf "  ${bg}✓${n} 0 failed\n"
	fi
	if (( ${#details[@]} > 0 )); then
		echo ""
		printf "  ${bc}What changed${n}\n"
		for detail in "${details[@]}"; do
			printf "  ${c}▸${n} ${d}%s${n}\n" "$detail"
		done
	fi
	echo ""
	printf "  ${d}Done in ${b}%dm %ds${n} ${d}at %s${n}\n" "$mins" "$secs" "$(date '+%H:%M')"
	if (( ${results[(Ie)Claude Code]} )); then
		printf "  ${d}Restart Claude Code for new version${n}\n"
	fi
	printf "  ${bg}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${n}\n"
	echo ""

	unfunction _spin _step _sync_repos 2>/dev/null
}
